{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && pnpm run lint && vite build && pnpm run sanitize-check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "sanitize-check": "node scripts/sanitize-check.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@wailsio/runtime": "3.1.0",
    "codemirror": "^5.65.16",
    "dompurify": "^3.2.4",
    "highlight.js": "11.9.0",
    "katex": "0.16.47",
    "marked": "15.0.12",
    "mermaid": "11.12.0",
    "pele": "1.13.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@babel/types": "^7.18.10",
    "@eslint/js": "^9.39.5",
    "@types/codemirror": "^5.60.8",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^18.19.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.1.10"
  }
}
